# Copy to .env and fill in. Never commit a real .env file.

# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# REQUIRED in production: long random string for signing session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# --- Predefined demo login (validated on the server only) ---
# For a public deployment, change these here — never in frontend code.
DEMO_EMAIL=meetduggar@gmail.com
DEMO_NAME=Meet Duggar
DEMO_PASSWORD=meet2005

# --- Admin login for /admin/dashboard (validated on the server only) ---
# The admin session is separate from the patient session. Never put these
# values in frontend code or commit a real .env file.
ADMIN_EMAIL=admin@healthwise.in
ADMIN_NAME=Administrator
ADMIN_PASSWORD=meet2005

# --- AI chatbot provider (optional) ---
# If AI_API_KEY is set, chatbot replies come from this OpenAI-compatible API.
# If unset, the chatbot answers from the built-in medical knowledge base.
# The key stays on the backend and is never sent to the browser.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
