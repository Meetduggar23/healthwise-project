# Copy to .env and fill in. Never commit a real .env file.

# Base URL of the HealthWise API.
# Leave empty in production (client and API are served from the same origin).
# In development the Vite proxy forwards /api to the API server, so this can
# also stay empty. Set it only if the API runs on a different host/port
# without the proxy, e.g. VITE_API_URL=http://localhost:4000
VITE_API_URL=
